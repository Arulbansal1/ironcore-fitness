# ---------------------------------------------------------------------------
# Customer Support Desk with AI Triage — environment configuration
# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
# Every variable below is read by the app; the ones marked OPTIONAL have a
# working local fallback so the project runs end-to-end without them.
# ---------------------------------------------------------------------------

# --- Database (REQUIRED) ---------------------------------------------------
# Postgres 16 with the pgvector extension. `docker compose up -d db` starts one
# that matches this URL exactly.
DATABASE_URL="postgresql://support:support@localhost:5432/support_desk?schema=public"
# Unpooled connection, used only by `prisma db push` / migrations, which cannot
# run through a transaction pooler.
#
# This must ALWAYS have a value — Prisma treats an empty string as missing and
# refuses to load the schema. Locally, set it to the same value as DATABASE_URL.
# On Vercel + Neon, set DATABASE_URL to the *pooled* string and this to the
# *direct* one.
DIRECT_URL="postgresql://support:support@localhost:5432/support_desk?schema=public"

# --- Auth (REQUIRED) -------------------------------------------------------
# Secret used to sign the session JWT. Generate one with:
#   openssl rand -base64 48
AUTH_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"
# Session lifetime in days.
AUTH_SESSION_DAYS="7"

# Public base URL, used in emails (password-reset / verification links).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Brevo transactional email (OPTIONAL) ----------------------------------
# Used to deliver the 6-digit OTP for email verification and password reset.
# Get a key at https://app.brevo.com/settings/keys/api
# If BREVO_API_KEY is empty the app falls back to CONSOLE DELIVERY: the OTP is
# printed to the server log and (when APP_DEV_SHOW_OTP=true) returned by the API
# so you can still complete the flow locally.
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="no-reply@support-desk.local"
BREVO_SENDER_NAME="Support Desk"

# Show the OTP in the API response + UI banner. NEVER enable in production.
APP_DEV_SHOW_OTP="true"

# --- OpenAI (OPTIONAL) -----------------------------------------------------
# Powers ticket classification, sentiment, summarisation and RAG reply drafts.
# Without a key the app uses the built-in deterministic local engine
# (keyword classifier + hashing embeddings). Every feature still works; the
# UI labels the model that produced each result.
OPENAI_API_KEY=""
OPENAI_CHAT_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# --- Slack SLA / escalation alerts (OPTIONAL) ------------------------------
# Incoming webhook URL: https://api.slack.com/messaging/webhooks
# Empty = alerts are recorded in the database and shown in the Escalations
# screen, but not pushed to Slack.
SLACK_WEBHOOK_URL=""
SLACK_ALERT_CHANNEL="#support-alerts"

# --- Background SLA worker (REQUIRED for the cron endpoint) ----------------
# Shared secret for POST /api/cron/sla-check. `npm run sla:worker` uses it.
CRON_SECRET="local-dev-cron-secret"
# How often the bundled worker polls, in seconds.
SLA_WORKER_INTERVAL_SECONDS="60"

# --- Uploads ---------------------------------------------------------------
# Directory (relative to project root or absolute) for ticket attachments.
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB="10"

# --- Deployment ------------------------------------------------------------
# Where attachment bytes live. "disk" writes to UPLOAD_DIR; "database" stores
# them in Postgres. Leave unset to choose automatically: database on serverless
# hosts (no persistent filesystem), disk everywhere else.
STORAGE_DRIVER=""

# Admin account(s) created by `npm run db:seed`, comma separated. The password is
# reset to SEED_ADMIN_PASSWORD (or the demo password) on every seed run.
SEED_ADMIN_EMAILS="priyanshura400na@gmail.com"
SEED_ADMIN_PASSWORD=""
