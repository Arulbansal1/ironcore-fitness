{
  "name": "customer-support-desk",
  "version": "1.0.0",
  "private": true,
  "description": "Customer Support Desk with AI Triage — full-stack ticketing platform with RAG, SLA automation and analytics.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build && node scripts/prepare-standalone.mjs",
    "start": "node scripts/start.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && npm run db:seed",
    "setup": "tsx --env-file-if-exists=.env scripts/setup.ts",
    "sla:worker": "tsx --env-file-if-exists=.env scripts/sla-worker.ts",
    "kb:reindex": "tsx --env-file-if-exists=.env scripts/reindex-kb.ts",
    "smoke": "tsx --env-file-if-exists=.env scripts/smoke-test.ts",
    "postinstall": "prisma generate",
    "vercel-build": "tsx scripts/preflight.ts && prisma generate && prisma db push --skip-generate && next build",
    "preflight": "tsx --env-file-if-exists=.env scripts/preflight.ts",
    "deploy": "vercel deploy --prod"
  },
  "prisma": {
    "seed": "tsx --env-file-if-exists=.env prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jose": "^5.9.6",
    "lucide-react": "^0.469.0",
    "next": "^15.5.23",
    "openai": "^4.77.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "^2.15.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.5.23",
    "postcss": "^8.4.49",
    "prisma": "^6.2.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vercel": "^59.1.3"
  },
  "engines": {
    "node": ">=20"
  }
}
